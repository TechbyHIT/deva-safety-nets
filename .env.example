# =============================================================================
# Deva Safety Nets — production environment (copy to .env on the VPS)
# =============================================================================
#   cp .env.example .env
#   nano .env
# =============================================================================

# --- Site (public — set before npm run build) ---
NEXT_PUBLIC_SITE_URL=https://devasafetynets.com
NEXT_PUBLIC_SITE_NAME="Deva Safety Nets"
NEXT_PUBLIC_BRAND_PHONE=+917558844405
NEXT_PUBLIC_WHATSAPP=917558844405
NEXT_PUBLIC_EMAIL=devasafetynetskochi@gmail.com
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18317175490

# --- PM2 deploy (no Docker) — optional ---
PM2_APP_NAME=deva-safety-nets
APP_PORT=3006
# Large static catalog — 384MB often OOMs and causes nginx 502
# For 50+ sites on 16GB RAM: prefer 384–512 for small sites; 768–1024 for SEO monsters
NODE_HEAP_MB=768
BUILD_HEAP_MB=2048
# After deploy, lean-post-build removes node_modules (set 1 to keep for debugging)
# LEAN_KEEP_NODE_MODULES=0

# --- Runtime ---
